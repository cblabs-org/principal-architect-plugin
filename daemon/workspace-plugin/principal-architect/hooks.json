{
  "principal-architect": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "PLUGIN_ROOT=\"${PLUGIN_ROOT:-${PA_DAEMON_HOME:-$HOME/.gemini/config/plugins/pa-daemon}/workspace-plugin/principal-architect}\"; python3 ${PLUGIN_ROOT}/scripts/pre_invocation.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|write_file|replace_file_content|edit_file|multi_replace_file_content|sed_file|notebook_edit|run_command|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_ROOT=\"${PLUGIN_ROOT:-${PA_DAEMON_HOME:-$HOME/.gemini/config/plugins/pa-daemon}/workspace-plugin/principal-architect}\"; python3 ${PLUGIN_ROOT}/scripts/pre_tool_gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_ROOT=\"${PLUGIN_ROOT:-${PA_DAEMON_HOME:-$HOME/.gemini/config/plugins/pa-daemon}/workspace-plugin/principal-architect}\"; python3 ${PLUGIN_ROOT}/scripts/post_tool_receipt.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "PLUGIN_ROOT=\"${PLUGIN_ROOT:-${PA_DAEMON_HOME:-$HOME/.gemini/config/plugins/pa-daemon}/workspace-plugin/principal-architect}\"; python3 ${PLUGIN_ROOT}/scripts/stop_gate.py",
        "timeout": 10
      }
    ]
  }
}
